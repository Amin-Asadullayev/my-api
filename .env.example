# Copy to .env for local development. Never commit the real .env.
PORT=3000

# Required in production (32+ characters). Generate one with: openssl rand -hex 32
JWT_SECRET=

# Optional. Without REDIS_URL the API works but nothing is cached.
REDIS_URL=redis://localhost:6379

MOVIES_DB_PATH=db/movies.db
AUTH_DB_PATH=db/auth.db

CACHE_TTL_SECONDS=60
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
